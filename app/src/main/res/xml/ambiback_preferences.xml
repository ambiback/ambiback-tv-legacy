<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/general_options">
        <SwitchPreferenceCompat
                app:key="enabledevicediscovery"
                app:title="@string/enabledevicediscovery_title"
                app:summary="@string/enabledevicediscovery_summary"
                app:defaultValue="true"
                />
<!--
        <EditTextPreference
                app:key="signature"
                app:title="@string/signature_title"
                app:useSimpleSummaryProvider="true" />

        <ListPreference
                app:defaultValue="reply"
                app:entries="@array/reply_entries"
                app:entryValues="@array/reply_values"
                app:key="reply"
                app:title="@string/reply_title"
                app:useSimpleSummaryProvider="true" />
-->
    </PreferenceCategory>

    <PreferenceCategory app:title="Screen Mirroring">
        <SwitchPreferenceCompat
                app:key="enablemirrorsupport"
                app:title="@string/screenmirror_support"
                app:summary="@string/screenmirror_support_summary"
                app:defaultValue="true"
                />
        <SwitchPreferenceCompat
                app:dependency="enablemirrorsupport"
                app:key="enablemirror"
                app:title="@string/screenmirror_autostart"
                app:summary="@string/screenmirror_autostart_summary"
                app:defaultValue="false"
                />

    </PreferenceCategory>

</PreferenceScreen>
