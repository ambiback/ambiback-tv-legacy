<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity" android:background="@android:color/holo_blue_dark">

    <ImageView
            android:layout_width="320dp"
            android:layout_height="240dp"
            android:id="@+id/imageViewPreview"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" android:background="#9F000000"
            android:contentDescription="Preview Box" android:layout_marginTop="86dp"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintVertical_bias="0.0"/>
    <ToggleButton
            android:text="Ambient Mode"
            android:layout_width="142dp"
            android:layout_height="40dp" tools:layout_editor_absoluteY="16dp"
            android:id="@+id/btnAmbientMode" android:onClick="clickButtonTest" android:layout_marginEnd="232dp"
            app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
            android:text="Ambient Status"
            android:layout_width="159dp"
            android:layout_height="40dp"
            android:id="@+id/textView"
            android:textAppearance="@style/TextAppearance.AppCompat.Large" android:textAlignment="textEnd"
            android:background="#BF000000" app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="233dp" android:layout_marginEnd="19dp"
            app:layout_constraintEnd_toStartOf="@+id/btnAmbientMode" app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="16dp" app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>